{
    "@context": ["https://www.w3.org/2022/wot/td/v1.1", { "tm": "https://www.w3.org/2022/wot/tm#" }],
    "@type": "tm:ThingModel",
    "title": "Patient Thing Model",
    "description": "Model describing patient vital signs",
    "tm:version": "1.0.0",
    "tm:properties": {
        "bpm": {
            "description": "current heart rate",
            "type": "number"
        },
        "oximetry":{
            "description": "Current blood oxygen saturation",
            "type": "number"
        }
    }
}